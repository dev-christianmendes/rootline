# Rootline Environment Variables
# Copy this file to .env and adjust values as needed
# Never commit .env to version control!

# ---------------------------------------------------------------------------
# API (FastAPI) - Prefix: ROOTLINE_
# ---------------------------------------------------------------------------

# Database connection URL
# PostgreSQL (production): postgresql+psycopg://user:pass@host:5432/db
# SQLite (development): sqlite:///apps/api/rootline.db
ROOTLINE_DATABASE_URL=postgresql+psycopg://rootline:rootline@localhost:5432/rootline

# Comma-separated list of allowed CORS origins for the Next.js dev server
ROOTLINE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Directory holding the seed datasets (services.json, incidents.json, ...)
# Default: <repo_root>/data/mock
ROOTLINE_SEED_DATA_DIR=

# Seed the database from seed_data_dir when it is empty (default: true)
ROOTLINE_AUTO_SEED=true

# Simulated analysis delay in milliseconds (default: 900)
# Set to 0 to return immediately
ROOTLINE_ANALYSIS_DELAY_MS=900

# Application version (default: 0.1.0)
ROOTLINE_APP_VERSION=0.1.0

# Environment name (default: development)
ROOTLINE_ENVIRONMENT=development

# Authentication
# Secret key for JWT token signing (CHANGE IN PRODUCTION!)
ROOTLINE_SECRET_KEY=change-me-in-production-use-a-secure-random-string
# Algorithm for JWT (default: HS256)
ROOTLINE_ALGORITHM=HS256
# Access token expiration in minutes (default: 10080 = 7 days)
ROOTLINE_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------

# Origin of the Rootline API (FastAPI).
# The browser always talks to the same-origin `/api/v1` path,
# and Next proxies it server side, which keeps CORS out of the picture.
# Override when the API runs elsewhere, e.g. http://localhost:8080
ROOTLINE_API_URL=http://localhost:8000

# Optional: Sentry DSN for error tracking (frontend)
# NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Mock Data Generator
# ---------------------------------------------------------------------------

# Base date for mock data generation (format: YYYY-MM-DD)
# The scenario anchor must be a literal constant, not derived from new Date().
# Override for date-shifted local development.
MOCK_BASE_DATE=2026-09-24

# ---------------------------------------------------------------------------
# Testing (API)
# ---------------------------------------------------------------------------

# Test database URL (used by pytest when running against PostgreSQL)
# ROOTLINE_TEST_DATABASE_URL=postgresql+psycopg://rootline:rootline@localhost:5433/rootline_test

# ---------------------------------------------------------------------------
# Docker / Infrastructure
# ---------------------------------------------------------------------------

# PostgreSQL credentials for docker-compose
POSTGRES_USER=rootline
POSTGRES_PASSWORD=rootline
POSTGRES_DB=rootline

# ---------------------------------------------------------------------------
# CI / CD (GitHub Actions)
# ---------------------------------------------------------------------------

# Node version for CI (also in .github/workflows/ci.yml)
# NODE_VERSION=22

# Python version for CI (also in .github/workflows/ci.yml)
# PYTHON_VERSION=3.12